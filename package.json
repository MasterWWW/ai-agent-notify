{
  "name": "ai-task-notify",
  "version": "0.1.0",
  "private": true,
  "description": "AI Agent task notifications pushed to vivo WATCH 5 via LAN WebSocket",
  "type": "module",
  "bin": {
    "ai-task-notify": "./bin/ai-task-notify"
  },
  "scripts": {
    "build": "pnpm --filter @ai-task-notify/server build",
    "dev": "pnpm --filter @ai-task-notify/server dev",
    "start": "pnpm --filter @ai-task-notify/server start",
    "test:permission": "node scripts/verify-permission.mjs",
    "build:app": "pnpm --filter ai-task-notify-desktop tauri build",
    "dmg": "bash desktop/scripts/make-dmg.sh",
    "build:rs": "cargo build --release --manifest-path server-rs/Cargo.toml --bin ai-task-notify",
    "install:rs": "cp server-rs/target/release/ai-task-notify ~/.local/bin/ai-task-notify && chmod +x ~/.local/bin/ai-task-notify"
  },
  "workspaces": [
    "server",
    "desktop"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
