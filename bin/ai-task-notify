#!/usr/bin/env bash
# AI Task Notify CLI — Rust binary (no Node).
#
# Resolves the Rust CLI in this order:
#   1. $AI_TASK_NOTIFY_BIN (explicit override)
#   2. ~/.local/bin/ai-task-notify   (installed copy)
#   3. <repo>/server-rs/target/release/ai-task-notify   (project release build)
#
# Hooks must stay silent on failure so they never break Codex/Claude:
# a missing binary only prints to stderr and exits 1 (agents fall back to
# their own terminal approval flow).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

BIN="${AI_TASK_NOTIFY_BIN:-}"
if [[ -z "$BIN" ]]; then
  if [[ -x "$HOME/.local/bin/ai-task-notify" ]]; then
    BIN="$HOME/.local/bin/ai-task-notify"
  elif [[ -x "$REPO_DIR/server-rs/target/release/ai-task-notify" ]]; then
    BIN="$REPO_DIR/server-rs/target/release/ai-task-notify"
  fi
fi

if [[ -z "$BIN" || ! -x "$BIN" ]]; then
  echo "ai-task-notify: Rust CLI not built. Run: pnpm build:rs" >&2
  exit 1
fi

exec "$BIN" "$@"
